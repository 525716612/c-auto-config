{
  "name": "c-auto-config",
  "displayName": "c auto config",
  "description": "jrymonitorconfig",
  "publisher": "cxy",
  "version": "1.1.2",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
  "type": "git",
  "url": ""
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "c-auto-config.helloWorld",
        "title": "Hello World"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "c-auto-config-sidebar",
          "title": "c auto config",
          "icon": "media/c_settings.svg"
        }
      ]
    },
    "views": {
      "c-auto-config-sidebar": [
        {
          "type": "webview",
          "id": "c-auto-config.webview",
          "name": "配置生成器"
        }
      ]
    },
    "configuration": {
      "title": "C工程配置工具",
      "properties": {
        "cAutoConfig.cygwinRoot": {
          "type": "string",
          "default": "D:\\cygwin",
          "description": "Cygwin 安装根目录，插件会自动拼接 bin/bash.exe 和 opt/aeon/bin/aeon-gcc.exe"
        },
        "cAutoConfig.compilerPath": {
          "type": "string",
          "default": "",
          "description": "编译器完整路径（如 D:\\cygwin\\opt\\aeon\\bin\\aeon-gcc.exe）。留空时自动从 cygwinRoot 拼接 opt/aeon/bin/aeon-gcc.exe"
        },
        "cAutoConfig.clangdTemplate": {
          "type": "object",
          "default": {
            "CompileFlags": {
              "Add": [
                "-fms-extensions",
                "-fpermissive",
                "-w",
                "-ferror-limit=0",
                "-Wno-unused-command-line-argument",
                "-Wno-unknown-attributes",
                "-Wno-invalid-token-paste",
                "-Wno-undefined-identifier",
                "-Wno-incomplete-type",
                "-Wno-flexible-array-extensions",
                "-Wno-unknown-pragmas",
                "-Wno-implicit-function-declaration",
                "-Wno-missing-prototypes",
                "-Wno-unused-function",
                "-D__aeon__",
                "-D__aeonr2__",
                "-Dxdata=",
                "-Dcode=",
                "-DMSOS_TYPE_NOS",
                "-D__CLANGD__"
              ]
            },
            "Remove": [
              "-march=aeonR2",
              "-march=*",
              "-mhard-div",
              "-mhard-mul",
              "-mredzone-size=*"
            ]
          },
          "markdownDescription": "clangd 配置文件的基础内容（将转换为 YAML 格式）。插件会自动添加 `If: PathExclude:` 块来排除非活动的 UI 文件夹。",
          "scope": "resource"
        },
        "cAutoConfig.extraDefines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "用户自定义的额外宏定义，会追加到 `C_Cpp.default.defines` 中。格式示例：`MY_MACRO=1` 或 `MY_FLAG`。插件内置的 GCC 兼容宏（`__attribute__`、`weak`、`packed` 等）不受此配置影响。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
